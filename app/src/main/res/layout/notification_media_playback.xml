<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#1E1E1E">

    <!-- Thumbnail Preview -->
    <ImageView
        android:id="@+id/notification_thumbnail"
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#333333"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_notification_icon" />

    <!-- Details and Media Controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <!-- Header row with Title and Close button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Video Title" />

            <!-- Close Tab Action -->
            <ImageButton
                android:id="@+id/btn_notification_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Tab"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/notification_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:text="Channel Name" />

        <!-- Media Controls Row (Large click targets: 48dp height/width) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Seek -10s -->
            <ImageButton
                android:id="@+id/btn_notification_rewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Rewind 10 seconds"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_replay_10" />

            <!-- Play / Pause -->
            <ImageButton
                android:id="@+id/btn_notification_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow" />

            <!-- Seek +10s -->
            <ImageButton
                android:id="@+id/btn_notification_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Forward 10 seconds"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward_10" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
